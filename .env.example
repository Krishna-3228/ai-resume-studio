# Data directory path
RESUME_DATA_DIR=data

# ==============================================================================
# LLM Provider Configuration (Choose any provider or set its API key)
# ==============================================================================
# The system automatically detects the active provider from whichever key is set.
# You can also explicitly specify LLM_PROVIDER (e.g. google, openai, anthropic, groq, ollama)

# --- Option 1: Google Gemini ---
# GEMINI_API_KEY=your_gemini_api_key_here
# LLM_MODEL=gemini-2.0-flash

# --- Option 2: OpenAI ---
# OPENAI_API_KEY=your_openai_api_key_here
# LLM_MODEL=gpt-4o

# --- Option 3: Anthropic Claude ---
# ANTHROPIC_API_KEY=your_anthropic_api_key_here
# LLM_MODEL=claude-3-5-sonnet-latest

# --- Option 4: Groq ---
# GROQ_API_KEY=your_groq_api_key_here
# LLM_MODEL=openai/gpt-oss-20b  # Ultra-fast (~1000 tps) | Alternate: openai/gpt-oss-120b, qwen/qwen3.8-27b

# --- Option 5: Local / Ollama / OpenAI-Compatible (DeepSeek, Together, vLLM) ---
# LLM_PROVIDER=ollama
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_MODEL=llama3.2

# Temperature (default: 0.2)
LLM_TEMPERATURE=0.2
